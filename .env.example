# Zikkaron environment
PORT=4000
DATABASE_URL=postgresql://zikkaron:zikkaron@localhost:5432/zikkaron
CORS_ORIGIN=http://localhost:3000
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# SIWE (Sign-In with Ethereum)
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=80002
SESSION_TTL_HOURS=24
NONCE_TTL_MINUTES=10

# Demo/tests only — spoofable. Keep disabled outside local test runs.
ALLOW_HEADER_AUTH=false

# First-run local bootstrap only. Set to an exact wallet, then unset after use.
BOOTSTRAP_ADMIN_WALLET=
ALLOW_PRIVILEGED_BOOTSTRAP=false
ALLOW_SIMULATED_SSO=false
API_RATE_LIMIT=120
AUTH_RATE_LIMIT=60

# County / assessor lookup adapters: simulated | http
GOV_LOOKUP_ADAPTER=simulated
GOV_LOOKUP_AUTO_PROCESS=true
# COUNTY_LOOKUP_URL=
# ASSESSOR_LOOKUP_URL=
# GOV_LOOKUP_API_KEY=
# GOV_LOOKUP_TIMEOUT_MS=8000

# Evidence storage. IPFS is preferred; hash-only fallback is explicit and configurable.
IPFS_API_URL=http://localhost:5001
IPFS_UPLOAD_REQUIRED=false
IPFS_TIMEOUT_MS=10000
MAX_DOCUMENT_BYTES=10485760

# DEPLOYER_PRIVATE_KEY=
# CONFIRM_MAINNET_DEPLOY=no
