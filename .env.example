# Zikkaron environment
# With NODE_ENV=production the API refuses to start if any ALLOW_* demo flag is true or if
# DATABASE_URL, METRICS_TOKEN, or KYC_HASH_PEPPER is missing.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://zikkaron:zikkaron@localhost:5432/zikkaron
# Comma-separated trusted browser origins (CORS + cookie CSRF origin check).
CORS_ORIGIN=http://localhost:3000
# Express trust proxy: false | true | hop count (e.g. 1) | subnet list. Set behind a load balancer
# so rate limits key on the real client IP.
TRUST_PROXY=false
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# SIWE (Sign-In with Ethereum)
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=80002
SESSION_TTL_HOURS=24
NONCE_TTL_MINUTES=10
# Session cookie is httpOnly + SameSite=Strict; Secure defaults on when NODE_ENV=production.
# SESSION_COOKIE_SECURE=true
# Minutes between expired nonce/session cleanup runs (0 disables the timer).
AUTH_CLEANUP_INTERVAL_MINUTES=60

# HMAC key for KYC payload hashes. Required in production; keep secret and stable.
KYC_HASH_PEPPER=
# Required in production; send as the x-metrics-token header to read /metrics.
METRICS_TOKEN=

# Demo/tests only — spoofable. Keep disabled outside local test runs.
ALLOW_HEADER_AUTH=false

# First-run local bootstrap only. Set to an exact wallet, then unset after use.
BOOTSTRAP_ADMIN_WALLET=
ALLOW_PRIVILEGED_BOOTSTRAP=false
ALLOW_SIMULATED_SSO=false
API_RATE_LIMIT=120
AUTH_RATE_LIMIT=60
NONCE_RATE_LIMIT=20
# Disputes per wallet per hour.
DISPUTE_RATE_LIMIT=5

# County / assessor lookup adapters: simulated | http
GOV_LOOKUP_ADAPTER=simulated
GOV_LOOKUP_AUTO_PROCESS=true
# COUNTY_LOOKUP_URL=
# ASSESSOR_LOOKUP_URL=
# GOV_LOOKUP_API_KEY=
# GOV_LOOKUP_TIMEOUT_MS=8000

# Evidence storage. IPFS is preferred; hash-only fallback is explicit and configurable.
IPFS_API_URL=http://localhost:5001
IPFS_UPLOAD_REQUIRED=false
IPFS_TIMEOUT_MS=10000
MAX_DOCUMENT_BYTES=10485760

# DEPLOYER_PRIVATE_KEY=
# UPGRADE_ADMIN_ADDRESS=0x...   # multisig/timelock; receives ADMIN + DEFAULT_ADMIN_ROLE, deployer renounces both
# CONFIRM_MAINNET_DEPLOY=no
