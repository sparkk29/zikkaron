NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_NAME=Polygon Amoy
# Client-side upload cap; keep in sync with the API's MAX_DOCUMENT_BYTES.
NEXT_PUBLIC_MAX_DOCUMENT_BYTES=10485760
# Sends the spoofable x-wallet-address header. Only for local demos against ALLOW_HEADER_AUTH=true.
NEXT_PUBLIC_ALLOW_HEADER_AUTH=false
